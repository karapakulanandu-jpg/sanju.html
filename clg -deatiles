            <div class="card">
                <h3>B.Tech</h3>
                <p>Engineering and Technology</p>
            </div>
            <div class="card">
                <h3>B.Sc</h3>
                <p>Science and Research</p>
            </div>
            <div class="card">
                <h3>B.Com</h3>
                <p>Commerce and Accounting</p>
            </div>
            <div class="card">
                <h3>BBA</h3>
                <p>Business Administration</p>
            </div>
        </div>
    </section>

    <section id="facilities">
        <h2>Our Facilities</h2>
        <ul>
            <li>📚 Library</li>
            <li>💻 Computer Laboratory</li>
            <li>🏏 Sports and Games</li>
            <li>🚌 Transportation</li>
            <li>📶 Wi-Fi Campus</li>
        </ul>
    </section>

    <section id="contact">
        <h2>Contact Us</h2>
        <p>Email: info@abccollege.edu</p>
        <p>Phone: +91 98765 43210</p>
        <p>Address: Your City, Andhra Pradesh, India</p>
    </section>

    <footer>
        <p>&copy; 2026 ABC College. All rights reserved.</p>
    </footer>

</body>
</html>
2. CSS code
Create another file named style.css in the same folder as index.html.
css

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    line-height: 1.6;
    background-color: #f4f7fc;
    color: #333;
}

header {
    background-color: #12305a;
    color: white;
    text-align: center;
    padding: 25px 15px;
}

header h1 {
    font-size: 32px;
}

nav {
    background-color: #1e4b82;
    text-align: center;
    padding: 14px;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 0 12px;
    font-weight: bold;
}

nav a:hover {
    color: #ffd166;
}

.hero {
    background: linear-gradient(135deg, #dbeafe, #eff6ff);
    text-align: center;
    padding: 80px 20px;
}

.hero h2 {
    font-size: 36px;
    color: #12305a;
    margin-bottom: 10px;
}

.hero p {
    margin-bottom: 25px;
}

.btn {
    display: inline-block;
    background-color: #12305a;
    color: white;
    padding: 12px 24px;
    border-radius: 6px;
    text-decoration: none;
}

.btn:hover {
    background-color: #2874a6;
}

section {
    padding: 45px 8%;
    text-align: center;
}

section h2 {
    color: #12305a;
    margin-bottom: 20px;
}

#about p {
    max-width: 750px;
    margin: auto;
}

.cards {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px;
}

.card {
    background: white;
    padding: 25px;
    width: 220px;
    border-radius: 10px;
    box-shadow: 0 4px 12px #00000015;
    transition: transform 0.3s;
}

.card:hover {
    transform: translateY(-6px);
}

.card h3 {
    color: #1e4b82;
    margin-bottom: 10px;
}

#facilities ul {
    list-style: none;
}

#facilities li {
    background: white;
    padding: 12px;
    margin: 10px auto;
    max-width: 400px;
    border-radius: 6px;
}

#contact {
    background-color: #e5edf8;
}

footer {
    background-color: #12305a;
    color: white;
    text-align: center;
    padding: 18px;
}

@media (max-width: 600px) {
    header h1 {
        font-size: 26px;
    }

    nav a {
        display: inline-block;
        margin: 5px 8px;
    }

    .hero h2 {
        font-size: 28px;
    }

    section {
        padding: 35px 5%;
    }

    .card {
        width: 100%;
        max-width: 350px;
    }
}
