<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ABC College</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <header>
        <h1>ABC College</h1>
        <p>Knowledge | Excellence | Success</p>
    </header>

    <nav>
        <a href="#home">Home</a>
        <a href="#about">About Us</a>
