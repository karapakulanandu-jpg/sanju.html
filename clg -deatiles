<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ABC College</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #f4f7fc;
            color: #333;
            line-height: 1.6;
        }

        header {
            background: #12305a;
            color: white;
            text-align: center;
            padding: 25px;
        }

        nav {
            background: #1e4b82;
            padding: 15px;
            text-align: center;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 10px;
            font-weight: bold;
        }

        nav a:hover {
            color: #ffd166;
        }

        .hero {
            background: linear-gradient(135deg, #dbeafe, #eff6ff);
            text-align: center;
            padding: 70px 20px;
        }

        .hero h2 {
            color: #12305a;
            font-size: 35px;
            margin-bottom: 15px;
        }

        .btn {
            display: inline-block;
            margin-top: 20px;
            background: #12305a;
            color: white;
            padding: 12px 25px;
            text-decoration: none;
            border-radius: 6px;
        }

        section {
            padding: 40px 8%;
            text-align: center;
        }

        h2 {
            color: #12305a;
            margin-bottom: 20px;
        }

        .courses {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 20px;
        }

        .card {
            background: white;
            padding: 25px;
            width: 220px;
            border-radius: 10px;
            box-shadow: 0 4px 10px #00000015;
        }

        .card h3 {
            color: #1e4b82;
            margin-bottom: 10px;
        }

        .card:hover {
            transform: translateY(-5px);
        }

        #facilities ul {
            list-style: none;
        }

        #facilities li {
            background: white;
            max-width: 400px;
            margin: 10px auto;
            padding: 12px;
            border-radius: 6px;
        }

        #contact {
            background: #e5edf8;
        }

        footer {
            background: #12305a;
            color: white;
            text-align: center;
            padding: 18px;
        }

        @media (max-width: 600px) {
            nav a {
                display: inline-block;
                margin: 6px;
            }

            .hero h2 {
                font-size: 27px;
            }

            .card {
                width: 100%;
                max-width: 350px;
            }
        }
    </style>
</head>

<body>

    <header>
        <h1>ABC College</h1>
        <p>Knowledge | Excellence | Success</p>
    </header>

    <nav>
        <a href="#home">Home</a>
        <a href="#about">About</a>
        <a href="#courses">Courses</a>
        <a href="#facilities">Facilities</a>
        <a href="#contact">Contact</a>
    </nav>

    <div class="hero" id="home">
        <h2>Welcome to ABC College</h2>
        <p>Learn Today, Lead Tomorrow!</p>
        <a href="#courses" class="btn">Explore Courses</a>
    </div>

    <section id="about">
        <h2>About Our College</h2>
        <p>
            ABC College provides quality education, experienced faculty,
            and modern facilities to help students achieve their goals.
            We encourage innovation, creativity, and academic excellence.
        </p>
    </section>

    <section id="courses">
        <h2>Our Courses</h2>

        <div class="courses">
            <div class="card">
                <h3>B.Tech</h3>
                <p>Engineering and Technology</p>
            </div>

            <div class="card">
                <h3>B.Sc</h3>
                <p>Science and Research</p>
            </div>

            <div class="card">
                <h3>B.Com</h3>
                <p>Commerce and Accounting</p>
            </div>

            <div class="card">
                <h3>BBA</h3>
                <p>Business Administration</p>
            </div>
        </div>
    </section>

    <section id="facilities">
        <h2>Our Facilities</h2>
        <ul>
            <li>📚 Library</li>
            <li>💻 Computer Laboratory</li>
            <li>🏏 Sports and Games</li>
            <li>🚌 Transportation</li>
            <li>📶 Wi-Fi Campus</li>
            <li>🏢 Modern Classrooms</li>
        </ul>
    </section>

    <section id="contact">
        <h2>Contact Us</h2>
        <p>Email: info@abccollege.edu</p>
        <p>Phone: +91 98765 43210</p>
        <p>Address: Your City, Andhra Pradesh, India</p>
    </section>

    <footer>
        <p>&copy; 2026 ABC College. All rights reserved.</p>
    </footer>

</body>
</html>
